# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live Voice Options: Aoede, Puck, Charon, Fenrir, Kore
GEMINI_VOICE=Charon

# Set to true if using Mac/PC speakers (prevents speaker echo from interrupting agent)
# Set to false if wearing headphones/AirPods for full-duplex live barge-in
ECHO_CANCELLATION=true
